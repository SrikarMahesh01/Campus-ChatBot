# Environment Variables for URCET Campus Chatbot

# Google Gemini API Key for AI-powered responses
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
VITE_APP_NAME=URCET Campus Chatbot
VITE_APP_VERSION=1.0.0

# College Information
VITE_COLLEGE_NAME=Usha Rama College of Engineering and Technology
VITE_COLLEGE_SHORT_NAME=URCET
